PORT=3000

# Monday API personal or app token used by backend GraphQL calls.
MONDAY_API_TOKEN=

# Monday GraphQL API version header.
MONDAY_API_VERSION=2025-04

# Configure one or more Jira accounts available in the board view dropdown.
# Example format:
# JIRA_ACCOUNTS_JSON=[{"id":"main","name":"Rodney Jira","baseUrl":"https://your-domain.atlassian.net","email":"jira-user@company.com","apiToken":"your-jira-api-token"}]
JIRA_ACCOUNTS_JSON=[]

# Optional for Monday webhook signature validation in future webhook processing.
MONDAY_SIGNING_SECRET=
